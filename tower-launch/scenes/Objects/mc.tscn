[sub_resource type="GDScript" id="GDScript_yc5nw"]
resource_name = "movement"
script/source = "extends CharacterBody2D

@onready var blue_animated_sprite: AnimatedSprite2D = $blueAnimatedSprite

#movement variables
const SPEED = 120.0
const JUMP_VELOCITY = -250.0
const MAX_JUMPTIME = 1
const VELOCITY_DECREASER = .75
var JUMP_HOLD_TIME := 0.0
var JUMPING := false
var push_force = 80.0
var direction := Input.get_axis(\"Left\", \"Right\")
#health variables
var health = 3
var stun = false

#animation

func _process(float) -> void:

# anytime the player gets stunned wait 2.5 to get back up
#might want to change this later on in the game because, a stun could mean constant damage
	if stun:
		if is_on_floor():
			await get_tree().create_timer(2.5).timeout
			stun = false

#Movement
func _physics_process(delta: float) -> void:
	
	direction = Input.get_axis(\"Left\", \"Right\")
	handleMovement(delta)
	handleAnimation()

func handleMovement(delta: float) -> void:
	if not is_on_floor():
		if JUMPING && JUMP_HOLD_TIME < MAX_JUMPTIME:
			velocity += (Vector2(0,-400) + get_gravity()) * delta
		else:
			velocity += get_gravity() * delta

	# Handle jump.
	if Input.is_action_just_pressed(\"Jump\") and is_on_floor() and !stun:
		velocity.y = JUMP_VELOCITY
		JUMPING = true
		JUMP_HOLD_TIME = 0.0
		if JUMP_HOLD_TIME == MAX_JUMPTIME:
			JUMPING = false
# extra jump from holding
	if Input.is_action_just_pressed(\"Jump\") and JUMPING and !stun:
		JUMP_HOLD_TIME += delta
	if Input.is_action_just_released(\"Jump\"):
		JUMPING = false
	if JUMP_HOLD_TIME >= MAX_JUMPTIME:
		JUMPING = false

# Get the input direction and handle the movement/deceleration.
	
	# As good practice, you should replace UI actions with custom gameplay actions.
	if direction and !stun:
		velocity.x = direction * SPEED
	else:
		velocity.x = move_toward(velocity.x, 0, SPEED)

	move_and_slide()
	
	for i in get_slide_collision_count():
		var c = get_slide_collision(i)
		if c.get_collider() is RigidBody2D:
			c.get_collider().apply_central_impulse(-c.get_normal() * push_force)

func handleAnimation() -> void:
	
	
	if is_on_floor() && !stun:
			if direction == 0 && Input.is_action_pressed(\"Down\"):
				blue_animated_sprite.play(\"crouch\")
			elif direction == 0:
				blue_animated_sprite.play(\"default\")
			elif direction != 0 && direction < 0:
				blue_animated_sprite.play(\"run_left\")
			else:
				blue_animated_sprite.play(\"run_right\")
	if !is_on_floor():
		if direction == 0:
			blue_animated_sprite.play(\"jump\")
		elif direction != 0 && direction < 0:
			blue_animated_sprite.play(\"jump_left\")
		else:
			blue_animated_sprite.play(\"jump_right\")
"

