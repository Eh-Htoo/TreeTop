[sub_resource type="GDScript" id="GDScript_a1qx6"]
resource_name = "GameState"
script/source = "extends Node2D

@onready var killzone: Area2D = $killzone
@onready var camera_2d: Camera2D = $Camera2D
@onready var mc: CharacterBody2D = $mc

var maxHeight = 0

func heightChecker() -> void:
	if mc.position.y < maxHeight:
		maxHeight = mc.position.y;

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass
# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	print(\"Max:\", maxHeight)
	print(\"playerheight:\", mc.position.y)
	heightChecker()
	camera_2d.position.y = maxHeight
 	killzone.position.y = maxHeight + a 120
	
	
	
"

