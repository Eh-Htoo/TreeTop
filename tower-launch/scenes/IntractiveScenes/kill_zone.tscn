[gd_scene format=3 uid="uid://bmpm1p881job3"]

[sub_resource type="GDScript" id="GDScript_5csqv"]
resource_name = "KillZone"
script/source = "extends Area2D

var fell = false

# Called when the node enters the scene tree for the first time.




func _on_body_entered(body: Node2D) -> void:
	
	body.health -= 1
	body.stun = true
	fell = true
"

[node name="Area2D" type="Area2D" unique_id=1874769976]
script = SubResource("GDScript_5csqv")

[connection signal="body_entered" from="." to="." method="_on_body_entered"]
